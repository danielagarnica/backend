# Copia este archivo con el nombre ".env" y reemplaza los valores.
# El archivo ".env" NUNCA se sube a GitHub.

# Cadena de conexión de Supabase (Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres.TU_ID_DE_PROYECTO:TU_CONTRASEÑA@TU_HOST.pooler.supabase.com:5432/postgres

# Clave secreta para las sesiones. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pega_aqui_una_clave_larga_y_aleatoria

# Opcional: puerto del servidor (por defecto 3000)
# PORT=3000
